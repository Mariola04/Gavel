{
  "title": "Parênteses equilibrados",
  "description": "Defina a função IsPaired(s string) bool que indica se todos os parênteses (), [] e {} em s estão corretamente emparelhados e encaixados. Os restantes caracteres são ignorados.",
  "difficulty": "hard",
  "function": "IsPaired",
  "params": ["string"],
  "param_names": ["s"],
  "returns": "bool",
  "timeout_ms": 1000,
  "tests": [
    {"input": ["[]"], "output": true},
    {"input": [""], "output": true},
    {"input": ["[["], "output": false},
    {"input": ["}{"], "output": false},
    {"input": ["{]"], "output": false},
    {"input": ["{ }"], "output": true},
    {"input": ["{[])"], "output": false},
    {"input": ["{[]}"], "output": true},
    {"input": ["{}[]"], "output": true},
    {"input": ["([{}({}[])])"], "output": true},
    {"input": ["{[)][]}"], "output": false},
    {"input": ["([{])"], "output": false},
    {"input": ["[({]})"], "output": false},
    {"input": ["[({}])"], "output": false},
    {"input": ["{}["], "output": false},
    {"input": ["[]]"], "output": false},
    {"input": [")()"], "output": false},
    {"input": ["{)()"], "output": false},
    {"input": ["(((185 + 223.85) * 15) - 543)/2"], "output": true},
    {"input": ["\\left(\\begin{array}{cc} \\frac{1}{3} & x\\\\ \\mathrm{e}^{x} &... x^2 \\end{array}\\right)"], "output": true}
  ]
}
