  "returns": "int",
  "timeout_ms": 1000,
  "tests": [
    {"input": [-9, 9], "output": 0},
    {"input": [0, 10], "output": 1},
    {"input": [-5, 0], "output": 5},
    {"input": [0, -1], "output": 10},
    {"input": [0, 0], "output": 10},
    {"input": [-0.1, -0.1], "output": 10},
    {"input": [0.7, 0.7], "output": 10},
    {"input": [0.8, -0.8], "output": 5},
    {"input": [-3.5, 3.5], "output": 5},
    {"input": [-3.6, -3.6], "output": 1},
