  "difficulty": "hard",
  "function": "FindFewestCoins",
  "params": ["[]int", "int"],
  "param_names": ["coins", "target"],
  "returns": "[]int",
  "timeout_ms": 1000,
  "tests": [
    {"input": [[1, 5, 10, 25], 1], "output": [1]},
    {"input": [[1, 5, 10, 25, 100], 25], "output": [25]},
    {"input": [[1, 5, 10, 25, 100], 15], "output": [5, 10]},
    {"input": [[1, 4, 15, 20, 50], 23], "output": [4, 4, 15]},
    {"input": [[1, 5, 10, 21, 25], 63], "output": [21, 21, 21]},
    {"input": [[1, 2, 5, 10, 20, 50, 100], 999], "output": [2, 2, 5, 20, 20, 50, 100, 100, 100, 100, 100, 100, 100, 100, 100]},
    {"input": [[2, 5, 10, 20, 50], 21], "output": [2, 2, 2, 5, 10]},
    {"input": [[4, 5], 27], "output": [4, 4, 4, 5, 5, 5]},
